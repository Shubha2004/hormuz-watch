# =====================================================================
# Hormuz Watch — environment variables
# =====================================================================
# IMPORTANT: Only variables prefixed with PUBLIC_ are exposed to the
# browser. NEVER put a secret API key behind the PUBLIC_ prefix — any
# PUBLIC_ variable ships to every visitor in client-side JavaScript.
#
# The dashboard works out of the box with clearly-labeled demo data.
# Live providers are attempted client-side where a keyless public API
# exists; everything else degrades gracefully to demo data with a
# visible DEMO badge. No secrets are required for local development.
# =====================================================================

# --- Demo / live toggles ------------------------------------------------
# Master switch: when true (default), all panels render demo data with a
# DEMO badge even if a live provider is configured.
PUBLIC_DEMO_MODE=true

# Attempt the keyless GDELT news API in the browser before falling back
# to bundled demo headlines. Set to false to always use demo news.
PUBLIC_GDELT_ENABLED=true

# --- Map tiles -----------------------------------------------------------
# Default: CARTO dark basemap (free, attribution required, no key).
# Override with any Leaflet-compatible tile URL template.
PUBLIC_MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>

# --- Future server-side providers (NOT for browser use) ------------------
# These are documented for a future server-rendered deployment. Do NOT
# rename them with a PUBLIC_ prefix — that would leak the keys.
#
# EIA_API_KEY=            # US Energy Information Administration (oil prices)
#                         # Get a free key at https://www.eia.gov/opendata/
# MARINETRAFFIC_API_KEY=  # MarineTraffic AIS API (vessel positions)
