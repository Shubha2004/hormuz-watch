---
import Layout from '../../layouts/Layout.astro';
import DemoBadge from '../../components/DemoBadge.svelte';
import { demoPosts, type BlogPost } from '../../lib/demo-data';

export function getStaticPaths() {
  return demoPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props as { post: BlogPost };

function formatDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC'
  });
}

const related = demoPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Layout title={post.title} description={post.excerpt} currentPath="/blog">
  <div class="mx-auto max-w-3xl">
    <p class="mb-4">
      <a href="/blog" class="btn-ghost">← Back to blog</a>
    </p>

    <article>
      <div class="flex flex-wrap items-center gap-2">
        <DemoBadge quality="simulated" note="Editorial demonstration article, not news reporting." client:load />
        {post.tags.map((tag) => (
          <span class="rounded-full bg-navy-700/60 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="mt-3 text-2xl sm:text-3xl font-bold text-white">{post.title}</h1>
      <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
        <span>By {post.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.readingMinutes} min read</span>
      </p>

      <div
        class="prose-hw mt-6 space-y-4 text-[15px] leading-relaxed text-slate-300 [&>h3]:pt-2 [&>h3]:text-lg [&>h3]:font-bold [&>h3]:text-white [&>ul]:list-disc [&>ul]:space-y-1.5 [&>ul]:pl-5 [&_strong]:text-white [&_a]:text-cyan-400"
        set:html={post.bodyHtml}
      />

      <aside class="panel panel-pad mt-8" aria-label="About the author">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">About the author</p>
        <p class="mt-1 font-bold text-white">{post.author}</p>
        <p class="mt-1 text-sm leading-relaxed text-slate-400">
          The Hormuz Watch editorial team writes explainers on shipping, insurance and energy data
          for demonstration purposes. Articles here are not news reporting.
        </p>
      </aside>
    </article>

    <section class="mt-10" aria-labelledby="related">
      <h2 id="related" class="card-title mb-4">Related articles</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {related.map((r) => (
          <article class="panel panel-pad flex flex-col transition-colors hover:border-cyan-400/30">
            <p class="text-xs text-slate-500">
              <time datetime={r.date}>{formatDate(r.date)}</time>
              <span aria-hidden="true"> · </span>
              <span>{r.readingMinutes} min read</span>
            </p>
            <h3 class="mt-2 font-bold leading-snug text-white">
              <a href={`/blog/${r.slug}`} class="hover:text-cyan-300">{r.title}</a>
            </h3>
            <p class="mt-2 flex-1 text-sm text-slate-400">{r.excerpt}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
