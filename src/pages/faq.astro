---
import Layout from '../layouts/Layout.astro';
import { demoFaq, demoGlossary } from '../lib/demo-data';

const letters = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].filter((letter) =>
  demoGlossary.some((g) => g.term.toUpperCase().startsWith(letter))
);
const groups = letters.map((letter) => ({
  letter,
  terms: demoGlossary.filter((g) => g.term.toUpperCase().startsWith(letter))
}));
---

<Layout
  title="FAQ & glossary"
  description="Frequently asked questions about Hormuz Watch and a glossary of shipping and energy terms."
  currentPath="/faq"
>
  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-white">FAQ &amp; glossary</h1>
    <p class="mt-2 text-slate-400">Answers about the dashboard, plus the shipping terms we use across the site.</p>
  </div>

  <section class="mb-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="card-title mb-4">Frequently asked questions</h2>
    <div class="space-y-3">
      {demoFaq.map((item) => (
        <details class="panel panel-pad group">
          <summary class="cursor-pointer list-none font-semibold text-slate-100 marker:text-cyan-400 [&::-webkit-details-marker]:hidden">
            <span class="mr-2 inline-block text-cyan-400 transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
            {item.question}
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="glossary-heading">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="glossary-heading" class="card-title">Glossary</h2>
      <nav aria-label="Glossary quick jump" class="flex flex-wrap gap-1">
        {letters.map((letter) => (
          <a
            href={`#glossary-${letter}`}
            class="rounded border border-navy-700 bg-navy-850 px-2 py-1 text-xs font-semibold text-cyan-400 hover:border-cyan-400/40 hover:text-cyan-300"
          >
            {letter}
          </a>
        ))}
      </nav>
    </div>

    {groups.map(({ letter, terms }) => (
      <div class="panel panel-pad mb-4">
        <h3 id={`glossary-${letter}`} class="mb-3 scroll-mt-24 text-lg font-bold text-white">
          {letter}
        </h3>
        <dl class="divide-y divide-navy-700/50">
          {terms.map((g) => (
            <div class="py-2.5">
              <dt class="text-sm font-semibold text-cyan-300">{g.term}</dt>
              <dd class="mt-0.5 text-sm text-slate-300">{g.definition}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </section>

  <p class="mt-6 text-sm text-slate-400">
    For how we label and source data, see
    <a href="/methodology" class="text-cyan-400 underline decoration-dotted underline-offset-2 hover:text-cyan-300"> methodology</a>.
  </p>
</Layout>
